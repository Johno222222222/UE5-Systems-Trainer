{
  "name": "ue5-system-architect",
  "productName": "UE5 System Architect",
  "version": "1.14.1",
  "description": "A local desktop app for designing Unreal Engine 5 gameplay systems.",
  "main": "desktop/main.js",
  "private": true,
  "author": "Johno",
  "scripts": {
    "start": "electron .",
    "server": "node desktop/dev-server.js",
    "test": "node --test desktop/test/*.js",
    "build:ui": "yarn --cwd frontend build",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.ue5.system-architect",
    "productName": "UE5 System Architect",
    "icon": "desktop/icons/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "!desktop/test/**",
      "frontend/build/**/*",
      "content/packs/**/*",
      "content/glossary/**/*",
      "content/templates/**/*",
      "content/community/**/*",
      "content/planned.json",
      "content/resources.json",
      "content/glossary.json",
      "ue-plugin/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": ["nsis"],
      "icon": "desktop/icons/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "UE5 System Architect",
      "installerIcon": "desktop/icons/icon.ico",
      "uninstallerIcon": "desktop/icons/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "maintainer": "Johno <johno222222222@users.noreply.github.com>"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "identity": null,
      "category": "public.app-category.developer-tools"
    }
  }
}
