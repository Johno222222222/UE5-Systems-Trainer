{
  "id": "tactical-ammo",
  "title": "Tactical FPS: Ammo & Reload",
  "summary": "Reload fills the magazine from reserve, or refuses when it cannot.",
  "when_to_use": "Use this when reload should move rounds from reserve into the magazine.",
  "common_mistakes": "A common mistake is to reload on the client, or to bind IA_Reload in two systems.",
  "variables": [
    {"name": "Magazine", "type": "int", "default": "10"},
    {"name": "MagSize", "type": "int", "default": "30"},
    {"name": "Reserve", "type": "int", "default": "90"},
    {"name": "Needed", "type": "int", "default": "0"}
  ],
  "graph": {
    "kind": "event",
    "name": "Reload",
    "nodes": [
      {"key": "input", "catalog": "enhanced-input", "x": 40, "y": 40, "data": {"action": "IA_Reload"}, "note": "IA_Reload is the key. The magazine and the reserve live on the weapon component, not in the widget."},
      {"key": "mag", "catalog": "get-variable", "x": 40, "y": 200, "data": {"variable": "Magazine", "varType": "int"}, "note": "Rounds currently in the gun. Read this before any Set, because a later Get sees the new value."},
      {"key": "size", "catalog": "get-variable", "x": 40, "y": 300, "data": {"variable": "MagSize", "varType": "int"}, "note": "How many rounds the magazine holds when it is full."},
      {"key": "less", "catalog": "less", "x": 280, "y": 180, "pinType": "int", "note": "Reload only if the magazine is not already full."},
      {"key": "reserve", "catalog": "get-variable", "x": 40, "y": 420, "data": {"variable": "Reserve", "varType": "int"}, "note": "Rounds still in the pack. This is what a reload spends."},
      {"key": "zero", "catalog": "literal", "x": 40, "y": 540, "data": {"varType": "int", "value": "0"}, "note": "Zero reserve means there is nothing to move."},
      {"key": "more", "catalog": "greater", "x": 280, "y": 400, "pinType": "int", "note": "Reserve must be above zero."},
      {"key": "both", "catalog": "and", "x": 520, "y": 280, "note": "Both questions have to pass. A full magazine or an empty pack takes the Else path."},
      {"key": "branch", "catalog": "branch", "x": 760, "y": 40, "note": "Then moves rounds. Else tells the player the reload cannot happen."},
      {"key": "missing", "catalog": "subtract", "x": 760, "y": 220, "pinType": "int", "note": "Mag size minus what is already loaded. That is how many rounds would fill the gun."},
      {"key": "moved", "catalog": "clamp", "x": 1000, "y": 220, "pinType": "int", "note": "Needed is the smaller of the gap and the reserve. Clamp reserve between 0 and the gap."},
      {"key": "setneed", "catalog": "set-variable", "x": 1240, "y": 40, "data": {"variable": "Needed", "varType": "int"}, "note": "Save Needed before either other Set. Pure math runs again for the next Set, so both Sets must read this cached count."},
      {"key": "got", "catalog": "get-variable", "x": 1240, "y": 200, "data": {"variable": "Needed", "varType": "int"}, "note": "The cached count. Magazine and Reserve both add or subtract this same number."},
      {"key": "sum", "catalog": "add", "x": 1480, "y": 180, "pinType": "int", "note": "New magazine count is the old count plus Needed."},
      {"key": "setmag", "catalog": "set-variable", "x": 1720, "y": 40, "data": {"variable": "Magazine", "varType": "int"}, "note": "Write the magazine from the cached Needed. Do this on the server before you play the reload montage."},
      {"key": "left", "catalog": "subtract", "x": 1480, "y": 340, "pinType": "int", "note": "Reserve loses the same cached Needed. Do not clamp again here, or a full reload would see a gap of zero."},
      {"key": "setres", "catalog": "set-variable", "x": 1960, "y": 40, "data": {"variable": "Reserve", "varType": "int"}, "note": "Write the reserve from that same Needed. The HUD reads both numbers. It does not decide them."},
      {"key": "nope", "catalog": "print-string", "x": 1040, "y": 40, "data": {"text": "Cannot reload"}, "note": "Else is a full magazine or an empty reserve. A sound is enough. Do not zero the magazine here."}
    ],
    "wires": [
