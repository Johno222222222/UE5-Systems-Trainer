    "notes": [
      {
        "topic": "interface-vs-cast",
        "author": "Blueprint Builder",
        "body": "A line trace finds the actor. An interface calls it. Keep the cast list out of the interact key."
      },
      {
        "topic": "authority-and-rpcs",
        "author": "Blueprint Builder",
        "body": "HasAuthority is the server for a replicated pawn. Change ammo and health there, then let OnRep update the mesh."
      }
    ]
  }
}
